# ---------------------------------------------------------------------------
# Jasmin HTTP API user (what your backend will use to send SMS)
# ---------------------------------------------------------------------------
JASMIN_USER= Your Username 
JASMIN_PASSWORD=change-me-strong-password
JASMIN_HTTP_URL=http://localhost:1401

# ---------------------------------------------------------------------------
# Upstream SMPP provider (the carrier aggregator you'll relay through)
#
# Ghana options — you still need a wholesale SMPP account from one of:
#   - Arkesel  (ask for SMPP creds, not just their REST API)
#   - Hubtel   (enterprise SMPP tier)
#   - Celcom Africa / mNotify
#   - D7 Networks / Infobip / Sinch (international, more expensive)
#
# Fill these in AFTER you have the SMPP account details from the provider.
# ---------------------------------------------------------------------------
SMPP_PROVIDER_HOST=smpp.your-provider.com
SMPP_PROVIDER_PORT=2775
SMPP_PROVIDER_USERNAME=your-smpp-username
SMPP_PROVIDER_PASSWORD=your-smpp-password
SMPP_PROVIDER_SYSTEM_TYPE=
SMPP_SOURCE_ADDR=Qrollix       # Your registered sender ID (max 11 chars, alphanumeric)

# ---------------------------------------------------------------------------
# Default route (which SMPP connector handles outbound SMS)
# Leave as mt_connector unless you set up multiple providers.
# ---------------------------------------------------------------------------
DEFAULT_CONNECTOR_ID=gh_provider
